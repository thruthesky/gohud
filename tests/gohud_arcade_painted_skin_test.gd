## 🧪 **Checks for the painted arcade skin** — `GoSkinArcadePainted` (`themes/skins/go_skin_arcade_painted.gd`): the
## hooks that wear the painted sprites (the card, the gold ribbon, the keycap, the round badges), the notice pill, the
## inks, the six-chunk gauge, the frosted scrim and the hooks that must not fall back to the plain gohud look.
##
##   GOHUD_TEST_SCRIPT="res://addons/gohud/tests/gohud_arcade_painted_skin_test.gd" bash addons/gohud/tools/run_tests.sh
##
## 🔑 The values are Magnet Mayhem's own (`src/ui/ui_theme.gd`) — the skin is that game's look, so a value that drifts
##    from it is a bug here, not a taste.
extends SceneTree

## The skin arcade_light uses — generated by `tools/make_theme.py` from `themes/palettes/arcade_light.json`.
const SKIN_PATH := "res://addons/gohud/themes/skins/gohud_skin_arcade_light.tres"
const SHADER_PATH := "res://addons/gohud/themes/skins/arcade_painted_blur.gdshader"
const INK := Color("#1d2340")

var passed := 0
var failed: Array[String] = []


func _initialize() -> void:
	if root.content_scale_mode == Window.CONTENT_SCALE_MODE_DISABLED:
		root.content_scale_mode = Window.CONTENT_SCALE_MODE_CANVAS_ITEMS
		root.content_scale_aspect = Window.CONTENT_SCALE_ASPECT_IGNORE
		root.content_scale_size = Vector2i(390, 844)
		await frames(2)
	GoUi.reset()
	GoUi.config.reduce_motion = true
	var skin := load(SKIN_PATH) as GoSkinArcadePainted
	check(skin != null, "resource: the .tres loads as a GoSkinArcadePainted")
	if skin != null:
		check(skin is GoSkinArcade, "resource: it is an arcade skin underneath")
		check(skin.skin_name == "arcade_light", "resource: skin_name is arcade_light")
		check(is_equal_approx(skin.arcade_scrim_blur, 3.0), "resource: the game's blur (arcade_scrim_blur 3)")
		_sprites(skin)
		_notice(skin)
		_inks(skin)
		_scrim(skin)
		await _ticks(skin)
		_no_plain_fallback(skin)
	print("gohud arcade painted tests: %d/%d passed" % [passed, passed + failed.size()])
	for line in failed: print("FAIL %s" % line)
	quit(0 if failed.is_empty() else 1)


func check(condition: bool, label: String) -> void:
	if condition: passed += 1
	else: failed.append(label)


func frames(count: int) -> void:
	for i in count: await process_frame


## [param box] is a `GoStyleBoxSprite` of [param file] with [param edge] and [param ppu].
func _is_sprite(box: StyleBox, file: String, edge: Vector4, ppu: float, label: String) -> void:
	var sprite := box as GoStyleBoxSprite
	check(sprite != null, "%s: a GoStyleBoxSprite (got %s)" % [label, box])
	if sprite == null: return
	check(sprite.texture != null and sprite.texture.resource_path.get_file() == file,
		"%s: the texture is %s (got %s)" % [label, file, sprite.texture.resource_path if sprite.texture else "none"])
	check(sprite.texture != null and sprite.texture.resource_path.begins_with(
		"res://addons/gohud/assets/arcade_light/painted/"), "%s: the texture is gohud's painted copy" % label)
	check(sprite.edge == edge, "%s: edge %s (got %s)" % [label, edge, sprite.edge])
	check(is_equal_approx(sprite.pixels_per_unit, ppu), "%s: %s px per unit (got %s)" % [label, ppu,
		sprite.pixels_per_unit])


func _margins(box: StyleBox) -> Vector4:
	return Vector4(box.content_margin_left, box.content_margin_top, box.content_margin_right, box.content_margin_bottom)


func _sprites(skin: GoSkinArcadePainted) -> void:
	var card_edge := Vector4(100, 100, 100, 140)
	for variant: StringName in [GoTheme.BOX_CARD, GoTheme.BOX_PANEL, GoTheme.BOX_HUD, GoTheme.BOX_POPUP]:
		var card := skin.surface_box(variant)
		_is_sprite(card, "card.png", card_edge, 3.0, "surface_box(%s)" % variant)
		check(_margins(card) == Vector4(24, 20, 24, 22), "surface_box(%s): PaintedCard's margins" % variant)
	_is_sprite(skin.floating_box(), "card.png", card_edge, 3.0, "floating_box")
	var faded := skin.surface_box(GoTheme.BOX_CARD, Color.TRANSPARENT, 0.5) as GoStyleBoxSprite
	check(faded != null and is_equal_approx(faded.tint.a, 0.5), "surface_box: alpha goes on the tint")
	var solid := skin.surface_box(GoTheme.BOX_CARD, Color.TRANSPARENT, 1.0) as GoStyleBoxSprite
	check(solid != null and solid.tint == Color.WHITE, "surface_box: alpha 1 and no accent is the sprite as painted")
	var accented := skin.surface_box(GoTheme.BOX_CARD, Color("#e8332f"), 1.0) as GoStyleBoxSprite
	check(accented != null and accented.tint != Color.WHITE and accented.tint.r > accented.tint.b,
		"surface_box: an accent tints the card towards it")
	var a := skin.surface_box() as GoStyleBoxSprite
	var b := skin.surface_box() as GoStyleBoxSprite
	if a != null and b != null:
		a.tint = Color.RED
		check(b.tint != Color.RED, "surface_box: every call is a new box (a caller may change it)")
	check(is_equal_approx(GoSkin.frame_margin(skin.surface_box(), SIDE_LEFT), 100.0 / 3.0),
		"frame_margin: the card's left frame is edge.x / ppu (got %s)" % GoSkin.frame_margin(skin.surface_box(), SIDE_LEFT))
	check(is_equal_approx(GoSkin.frame_margin(skin.surface_box(), SIDE_BOTTOM), 140.0 / 3.0),
		"frame_margin: the card's bottom frame is edge.w / ppu")

	var plate := skin.title_plate_box()
	_is_sprite(plate, "ribbon_gold.png", Vector4(100, 80, 100, 80), 3.4, "title_plate_box")
	if plate != null: check(_margins(plate) == Vector4(22, 6, 22, 12), "title_plate_box: RibbonTitle's margins")

	var kbd := skin.kbd_box()
	_is_sprite(kbd, "keycap.png", Vector4(70, 70, 70, 80), 5.5, "kbd_box")
	if kbd != null: check(_margins(kbd) == Vector4(9, 1, 9, 5), "kbd_box: KeycapPanel's margins")

	_is_sprite(skin.badge_box(Color("#3ecf5a")), "badge_green.png", Vector4(100, 100, 100, 100), 3.0, "badge_box(green)")
	_is_sprite(skin.badge_box(Color("#2fa84f")), "badge_green.png", Vector4(100, 100, 100, 100), 3.0,
		"badge_box(deep green)")
	_is_sprite(skin.badge_box(Color("#3d6bff")), "badge_blue.png", Vector4(100, 100, 100, 100), 3.0, "badge_box(blue)")
	_is_sprite(skin.badge_box(Color("#ff4d4d")), "badge_blue.png", Vector4(100, 100, 100, 100), 3.0, "badge_box(red)")
	var badge := skin.badge_box(Color("#3d6bff"))
	check(badge.content_margin_left == skin.badge_pad_x and badge.content_margin_top == skin.badge_pad_y,
		"badge_box: the badge padding dials")


## The game's notification pill (`UiTheme` "Notif"): a white pill with a blue rim and a deeper bottom edge.
func _notice(skin: GoSkinArcadePainted) -> void:
	var notice := skin.notice_box(Color.TRANSPARENT, false) as StyleBoxFlat
	check(notice != null, "notice_box: the game's Notif is a StyleBoxFlat")
	if notice == null: return
	check(notice.bg_color == Color(1, 1, 1, 0.9), "notice_box: PANEL white at 0.9")
	check(notice.border_color == Color("#3d6bff"), "notice_box: CONTROL_BLUE rim")
	check(notice.border_width_left == 3 and notice.border_width_top == 3 and notice.border_width_right == 3
		and notice.border_width_bottom == 5, "notice_box: 3 px rim, 5 px bottom edge")
	check(notice.corner_radius_top_left == 16 and notice.corner_radius_bottom_right == 16, "notice_box: radius 16")
	check(notice.shadow_color == INK and notice.shadow_size == 3 and notice.shadow_offset == Vector2(0, 2),
		"notice_box: the INK outer edge")
	check(_margins(notice) == Vector4(12, 5, 12, 7), "notice_box: Notif's margins")
	var own := skin.notice_box(Color("#ffc928"), false) as StyleBoxFlat
	check(own != null and own.border_color == Color("#ffc928") and own.bg_color.is_equal_approx(Color("#fff3cf")),
		"notice_box: a gold accent is NotifPlayer (gold rim on cream)")
	var tinted := skin.notice_box(Color.TRANSPARENT, false)
	skin.tint_notice(tinted, Color("#ffc928"))
	check((tinted as StyleBoxFlat).border_color == Color("#ffc928"), "tint_notice: the accent paints the rim")
	skin.tint_notice(tinted, Color.TRANSPARENT)
	check((tinted as StyleBoxFlat).border_color == Color("#ffc928"), "tint_notice: no accent leaves it")
	var faded := skin.notice_box(Color.TRANSPARENT, false, 0.5) as StyleBoxFlat
	check(faded != null and is_equal_approx(faded.bg_color.a, 0.45), "notice_box: alpha multiplies the white")


func _inks(skin: GoSkinArcadePainted) -> void:
	check(skin.title_plate_ink() == Color.WHITE, "title_plate_ink: white")
	check(skin.kbd_ink() == INK, "kbd_ink: INK (got %s)" % skin.kbd_ink().to_html())
	var label := Label.new()
	skin.dress_title(label)
	check(label.get_theme_color(&"font_outline_color") == INK, "dress_title: an INK outline")
	check(label.get_theme_constant(&"outline_size") == 5, "dress_title: RibbonHeader's outline of 5")
	label.free()


func _scrim(skin: GoSkinArcadePainted) -> void:
	check(skin.arcade_scrim_blur > 0.0, "scrim: the painted skin frosts by default")
	var material := skin.scrim_material() as ShaderMaterial
	check(material != null, "scrim: a ShaderMaterial while the dial is above 0")
	if material != null:
		check(material.shader != null and material.shader.resource_path == SHADER_PATH, "scrim: the game's blur shader")
		check(is_equal_approx(float(material.get_shader_parameter(&"blur_lod")), 3.0)
			and is_equal_approx(float(material.get_shader_parameter(&"spread")), 6.0),
			"scrim: dial 3 is the game's blur (lod 3, spread 6)")
		var wash: Color = material.get_shader_parameter(&"wash")
		check(wash.is_equal_approx(Color(0.12, 0.28, 0.6, 0.22)), "scrim: the game's blue wash")
	var off := skin.duplicate() as GoSkinArcadePainted
	off.arcade_scrim_blur = 0.0
	check(off.scrim_material() == null, "scrim: dial 0 is the plain veil (null)")


func _ticks(skin: GoSkinArcadePainted) -> void:
	check(skin.bar_ticks() == 6, "bar_ticks: 6 (got %d)" % skin.bar_ticks())
	var canvas := Control.new()
	canvas.size = Vector2(240, 20)
	var drew := [false]
	canvas.draw.connect(func() -> void:
		skin.draw_bar_ticks(canvas, Rect2(Vector2.ZERO, canvas.size), 6)
		drew[0] = true)
	root.add_child(canvas)
	canvas.queue_redraw()
	await frames(3)
	check(drew[0], "draw_bar_ticks: draws on a Control's canvas")
	canvas.queue_free()


## Hooks the base gohud look would take over once the theme's boxes are sprites: they stay arcade keys.
func _no_plain_fallback(skin: GoSkinArcadePainted) -> void:
	check(skin.progress_fill_box(Color("#3ecf5a")) is GoStyleBoxArcade, "progress_fill_box: a painted arcade tube")
	var face := skin.surface_box()
	for state: StringName in [&"normal", &"hover", &"pressed", &"disabled"]:
		check(skin.outlined_button_box(face.duplicate(), state) is GoStyleBoxArcade,
			"outlined_button_box(%s): an arcade key cap, not the plain wash" % state)
