[resource]
script = ExtResource("script")
set_name = "gohud game icons"
attribution = "gohud game icon set, MIT. 168 icons use path data from Tabler Icons 3.46.0 (https://tabler.io/icons), MIT License, Copyright (c) 2020-2026 Pawel Kuna. 16 icons were drawn for gohud. See THIRD_PARTY_NOTICES.md."
