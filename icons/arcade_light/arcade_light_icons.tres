[resource]
script = ExtResource("script")
set_name = "Arcade painted glyphs"
attribution = "White painted glyphs from the Magnet Mayhem game (Withcenter), drawn for that game; plus, minus and close painted for gohud in the same style (tools/paint_arcade_glyphs.gd); star is the filled gold rating star (tools/paint_arcade_stars.gd); magnet_arrow and fall, the kill feed's glyphs, painted for gohud from magnet.png and in the same style (tools/paint_arcade_killfeed.gd); multiplayer, three people for a menu's multiplayer button, painted for gohud in the same style (tools/paint_arcade_multiplayer.gd); duo, two people side by side for a play-together key (duo.svg, drawn for gohud in the same style); mail, an envelope for an e-mail sign-in, painted the same way (tools/paint_arcade_sign_in.gd); google and apple, the sign-in brand marks (the multi-colour Google G, drawn in its own colours, and the Simple Icons Apple logo, CC0, white); discord, a community-link mark (the Simple Icons Discord logo, CC0, white) — see THIRD_PARTY_NOTICES.md. gohud's own names (home, refresh, settings, ...) point at them; everything else is the gohud default set."
fallback = ExtResource("fallback")
textures = {
&"back": ExtResource("back"),
&"check": ExtResource("check"),
&"exit": ExtResource("exit"),
&"gear": ExtResource("gear"),
&"globe": ExtResource("globe"),
