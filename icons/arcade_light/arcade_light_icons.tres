[resource]
script = ExtResource("script")
set_name = "Arcade painted glyphs"
attribution = "White painted glyphs from the Magnet Mayhem game (Withcenter), drawn for that game. gohud's own names (home, refresh, settings, ...) point at them; everything else is the gohud default set."
fallback = ExtResource("fallback")
textures = {
&"back": ExtResource("back"),
&"check": ExtResource("check"),
&"exit": ExtResource("exit"),
&"gear": ExtResource("gear"),
&"globe": ExtResource("globe"),
&"help": ExtResource("help"),
&"pause": ExtResource("pause"),
&"play": ExtResource("play"),
&"retry": ExtResource("retry"),
&"skip": ExtResource("skip"),
&"sound_low": ExtResource("sound_low"),
&"sound_off": ExtResource("sound_off"),
&"sound_on": ExtResource("sound_on"),
&"trophy": ExtResource("trophy"),
&"home": ExtResource("exit"),
&"refresh": ExtResource("retry"),
&"forward": ExtResource("skip"),
&"crown": ExtResource("trophy"),
&"settings": ExtResource("gear"),
&"volume_high": ExtResource("sound_on"),
&"volume_low": ExtResource("sound_low"),
&"volume_off": ExtResource("sound_off")
}
